{
  "name": "rhystic-buddy",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "-+-": "",
    "how to run these?": "run `yarn + the command you want to run`",
    "+-+": "",
    "android": "react-native run-android",
    "android:apk": "cd android && ./gradlew assembleRelease && cd .. && echo '✅ APK built at: android/app/build/outputs/apk/release/app-release.apk'",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "install-all": "yarn install && bundle install && cd ios && pod install && cd ..",
    "clean": "rm -rf node_modules yarn.lock && cd ios && rm -rf Pods Podfile.lock build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "optimize:assets": "node scripts/optimize-images.js",
    "check-unused": "depcheck",
    "prepare": "husky install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react-native": "^1.71.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "^2.33.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-svg": "^15.16.1",
    "react-native-worklets": "~0.13.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "depcheck": "^1.4.3",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.7",
    "fast-glob": "^3.3.2",
    "husky": "^9.1.7",
    "imagemin": "9.0.1",
    "imagemin-jpegtran": "^7.0.0",
    "imagemin-optipng": "^8.0.0",
    "imagemin-pngquant": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write",
    "**/*.{ts,tsx}": "bash -c 'yarn typecheck'"
  },
  "packageManager": "yarn@1.22.21+sha512.ca75da26c00327d26267ce33536e5790f18ebd53266796fbb664d2a4a5116308042dd8ee7003b276a20eace7d3c5561c3577bdd71bcb67071187af124779620a"
}
